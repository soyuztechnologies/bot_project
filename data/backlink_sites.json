  {
    "id": "site24x7_ping_test",
    "name": "Site24x7 Ping Test",
    "url": "https://www.site24x7.com/ping-test.html",
    "enabled": true,
    "input_type": "single",
    "input": {
      "primary_xpath": "//input[@placeholder='www.example.com']",
      "fallbacks": ["//form//input[@type='text' or @type='url']", "//input[contains(@placeholder,'example.com')]"]
    },
    "submit": {
      "primary_xpath": "//button[contains(translate(normalize-space(.),'PING NOW','ping now'),'ping now')]",
      "fallbacks": ["//button[contains(translate(.,'PING','ping'),'ping')]", "//input[contains(translate(@value,'PING','ping'),'ping')]"]
    },
    "result": {
      "primary_xpath": "//*[contains(translate(.,'RESULT','result'),'result') or contains(translate(.,'PACKET','packet'),'packet')]",
      "fallbacks": ["//table", "//*[contains(translate(.,'PING','ping'),'ping')]"],
      "success_hint": "Ping test page rendered a result after submission",
      "wait_seconds": 45
    },
    "success_without_result": true
  },
