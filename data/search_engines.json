{
  "google": {
    "url": "https://www.google.com",
    "searchUrl": "https://www.google.com/search?q={query}",
    "openTarget": "direct",

    "searchBox": {
      "by": "NAME",
      "value": "q"
    },

    "nextButton": {
      "by": "ID",
      "value": "pnnext"
    },

    "resultLinks": {
      "by": "XPATH",
      "value": "//a[@href]"
    },

    "videoTab": {
      "by": "XPATH",
      "value": "//a[.//span[normalize-space()='Videos']]"
    },

    "videoResultLinks": {
      "by": "XPATH",
      "value": "//a[contains(@href,'youtube.com/watch') and contains(@class,'zReHs')]"
    },

    "videoResultChannel": {
       "by": "XPATH",
       "value": ".//span[normalize-space()='Anubhav Trainings (official channel)']"
    },

    "videoResultTarget": {
      "by": "XPATH",
      "value": "//div[@role='button' and contains(@aria-label,'by Anubhav Trainings (official channel) on YouTube')]"
    }

    
  },

  "bing": {
    "url": "https://www.bing.com",
    "searchUrl": "https://www.bing.com/search?q={query}",
    "openTarget": "direct",

    "searchBox": {
      "by": "ID",
      "value": "sb_form_q"
    },

    "nextButton": {
      "by": "CSS_SELECTOR",
      "value": ".sb_pagN"
    },

    "resultLinks": {
      "by": "XPATH",
      "value": "div.mc_vtvc_con_rc[ourl]"
    },

    "videoTab": {
      "by": "XPATH",
      "value": "//a[normalize-space()='Videos']"
    },

    "videoResultLinks": {
      "by": "CSS_SELECTOR",
      "value": "div.mc_vtvc_con_rc[ourl]"
    },

    "videoResultChannel": {
      "by": "CSS_SELECTOR",
      "value": ".mc_vtvc_meta_row_channel"
    }
  },

  "duckduckgo": {
    "url": "https://duckduckgo.com",
    "searchUrl": "https://duckduckgo.com/?q={query}",
    "openTarget": "direct",

    "searchBox": {
      "by": "NAME",
      "value": "q"
    },

    "nextButton": {
      "by": "ID",
      "value": "more-results"
    },

    "resultLinks": {
      "by": "XPATH",
      "value": "//a[@href]"
    },

    "videoTab": {
      "by": "XPATH",
      "value": "//a[contains(@href,'ia=videos') or contains(@href,'iax=videos')]"
    },

    "videoResultLinks": {
      "by": "CSS_SELECTOR",
      "value": "a[href*='youtube.com/watch']"
    },

    "videoResultPublisher": {
       "by": "CSS_SELECTOR",
       "value": "span"
    },

    "isDuckDuckGo": true
  },

  "yahoo": {
    "url": "https://search.yahoo.com",
    "searchUrl": "https://search.yahoo.com/search?p={query}",
    "openTarget": "direct",

    "searchBox": {
      "by": "NAME",
      "value": "p"
    },

    "nextButton": {
      "by": "CSS_SELECTOR",
      "value": "a.next"
    },

    "resultLinks": {
      "by": "XPATH",
      "value": "//a[@href]"
    },

    "videoTab": {
      "by": "XPATH",
      "value": "//a[contains(@href,'video.search.yahoo.com')]"
    },

    "videoResultLinks": {
      "by": "CSS_SELECTOR",
      "value": "a.video-tile[data-referenceurl*='youtube.com/watch']"
    }
  }
}
