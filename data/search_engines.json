{
  "google": {
    "url": "https://www.google.com",
    "searchUrl": "https://www.google.com/search?q={query}",
    "openTarget": "direct",

    "searchBox": {
      "by": "NAME",
      "value": "q"
    },

    "nextButton": {
      "by": "ID",
      "value": "pnnext"
    },

    "resultLinks": {
      "by": "XPATH",
      "value": "//a[@href]"
    },

    "videoTab": {
      "by": "XPATH",
      "value": "//a[contains(translate(., 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'videos') or contains(@href, 'tbm=vid')]"
    },

    "videoResultLinks": {
      "by": "XPATH",
      "value": "//a[contains(@href,'youtube.com/watch')]"
    },

    "videoResultChannel": {
       "by": "XPATH",
       "value": ".//span[normalize-space()='Anubhav Trainings (official channel)']"
    },

    "videoResultTarget": {
      "by": "XPATH",
      "value": "//div[@role='button' and contains(@aria-label,'by Anubhav Trainings (official channel) on YouTube')]"
    }

    
  },

  "bing": {
    "url": "https://www.bing.com",
    "searchUrl": "https://www.bing.com/search?q={query}",
    "openTarget": "direct",

    "searchBox": {
      "by": "ID",
      "value": "sb_form_q"
    },

    "nextButton": {
      "by": "CSS_SELECTOR",
      "value": ".sb_pagN"
    },
    "resultLinks": {
      "by": "XPATH",
      "value": "//h2/a"
    },

    "videoTab": {
      "by": "XPATH",
      "value": "//a[contains(translate(., 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'videos')]"
    },

    "videoResultLinks": {
      "by": "CSS_SELECTOR",
      "value": "div.mc_vtvc_con_rc[ourl]"
    },

    "videoResultChannel": {
      "by": "CSS_SELECTOR",
      "value": ".mc_vtvc_meta_row_channel"
    }
  },

  "duckduckgo": {
    "url": "https://html.duckduckgo.com/html/",
    "searchUrl": "https://html.duckduckgo.com/html/?q={query}",
    "openTarget": "direct",

    "searchBox": {
      "by": "NAME",
      "value": "q"
    },

    "nextButton": {
      "by": "XPATH",
      "value": "//div[contains(@class,'nav-link')]//input[@type='submit']"
    },

    "resultLinks": {
      "by": "XPATH",
      "value": "//a[contains(@href,'/l/?uddg=')]"
    },

    "videoTab": {
      "by": "XPATH",
      "value": "//a[contains(@href,'ia=videos')]"
    },

    "videoResultLinks": {
      "by": "XPATH",
      "value": "//a[contains(@href,'/l/?uddg=')]"
    },

    "videoResultPublisher": {
       "by": "CSS_SELECTOR",
       "value": "span"
    },

    "isDuckDuckGo": true
  },

  "yahoo": {
    "url": "https://search.yahoo.com",
    "searchUrl": "https://search.yahoo.com/search?p={query}",
    "openTarget": "direct",

    "searchBox": {
      "by": "NAME",
      "value": "p"
    },

    "nextButton": {
      "by": "CSS_SELECTOR",
      "value": "a.next"
    },

    "resultLinks": {
      "by": "XPATH",
      "value": "//a[@href]"
    },

    "videoTab": {
      "by": "XPATH",
      "value": "//a[contains(@href,'video.search.yahoo.com') or contains(translate(., 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'videos')]"
    },

    "videoResultLinks": {
      "by": "CSS_SELECTOR",
      "value": "a.video-tile[data-referenceurl*='youtube.com/watch']"
    }
  }
}
