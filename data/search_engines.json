{
  "google": {
    "url": "https://www.google.com",
    "searchUrl": "https://www.google.com/search?q={query}",
    "openTarget": "direct",

    "searchBox": {
      "by": "NAME",
      "value": "q"
    },

    "nextButton": {
      "by": "ID",
      "value": "pnnext"
    },

    "resultLinks": {
      "by": "XPATH",
      "value": "//a[@href]"
    }
  },

  "bing": {
    "url": "https://www.bing.com",
    "searchUrl": "https://www.bing.com/search?q={query}",
    "openTarget": "direct",

    "searchBox": {
      "by": "ID",
      "value": "sb_form_q"
    },

    "nextButton": {
      "by": "CSS_SELECTOR",
      "value": ".sb_pagN"
    },

    "resultLinks": {
      "by": "XPATH",
      "value": "//a[@href]"
    }
  },

  "duckduckgo": {
    "url": "https://duckduckgo.com",
    "searchUrl": "https://duckduckgo.com/?q={query}",
    "openTarget": "direct",

    "searchBox": {
      "by": "NAME",
      "value": "q"
    },

    "nextButton": {
      "by": "ID",
      "value": "more-results"
    },

    "resultLinks": {
      "by": "XPATH",
      "value": "//a[@href]"
    }
  },

  "yahoo": {
    "url": "https://search.yahoo.com",
    "searchUrl": "https://search.yahoo.com/search?p={query}",
    "openTarget": "direct",

    "searchBox": {
      "by": "NAME",
      "value": "p"
    },

    "nextButton": {
      "by": "CSS_SELECTOR",
      "value": "a.next"
