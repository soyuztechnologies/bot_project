{
  "browser": {
    "name": "chrome",
    "mode": "headed",
    "maximize": false,

  

    "distribution": {
        "chrome" : 20,
        "edge" : 20,
        "brave" : 20,
        "firefox" : 20,
        "opera" : 20    
    }
  },

  "vpn": {
  "enabled": true,
  "provider": "nordvpn",
  "installation_dir": "C:\\Program Files\\NordVPN",
  "verify_connection": true
},



  "database": {
    "current_db": "prod",
    "db": {
      "public": "CONNECTION_URL_TEST",
      "prod": "CONNECTION_URL_PROD"
    }
  },


  "sessions": {
    "parallel": 5,
    "iterations": 1
  },

  "search": {
    "engines": [ "google","bing","yahoo", "duckduckgo"],
    "maxPages": 20
  },

  "website": {
    "domain": "anubhavtrainings.com",
    "extra_keyword": "anubhav training",
    "internal_links": {
      "enabled": true,
      "max_to_visit": 3,
      "selectors": ["//wix-dropdown-menu//a"]
    }
  },

  "youtube": {
    "targetChannel": "Anubhav Trainings",
    "extra_keyword": "anubhav training",
    "watchTimeMin": 20,
    "watchTimeMax": 40,
    "maxScrolls": 10,
    "maxSearchPages": 1,

    "retryCount": 3,
    "navigationRetryDelay": 10
  },

  "timing": {
    "typingMin": 0.1,
    "typingMax": 0.25,

    "sleepMin": 2,
    "sleepMax": 4,

    "scrollMin": 2,
    "scrollMax": 5
  },

  "files": {
    "keywords": "data/keywords.json",
    "searchEngines": "data/search_engines.json"
  }
}


