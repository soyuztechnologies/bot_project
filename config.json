{
  "browser": {
    "name": "chrome",
    "mode": "headless",
    "maximize": true,

    "browsers": ["chrome"],

    "distribution": {
        "chrome" : 80,
        "edge" : 20,
        "brave" : 0,
        "firefox" : 0,
        "opera" : 0    
    }
  },


  "database": {
    "current_db": "atlas",
    "db": {
      "local": "MONGO_URI_LOCAL",
      "atlas": "MONGO_URI_ATLAS"
    }
  },


  "sessions": {
    "parallel": 5,
    "iterations": 1
  },

  "search": {
    "engines": [ "google","bing","yahoo", "duckduckgo"],
    "maxPages": 20
  },

  "website": {
    "domain": "anubhavtrainings.com",
    "extra_keyword": "anubhav training",
    "internal_links": {
      "enabled": true,
      "max_to_visit": 3,
      "selectors": ["//wix-dropdown-menu//a"]
    }
  },

  "youtube": {
    "targetChannel": "Anubhav Trainings",
    "extra_keyword": "anubhav training",
    "watchTimeMin": 20,
    "watchTimeMax": 40,
    "maxScrolls": 10,
    "maxSearchPages": 1,

    "retryCount": 3,
    "navigationRetryDelay": 10
  },

  "timing": {
    "typingMin": 0.1,
    "typingMax": 0.25,

    "sleepMin": 2,
    "sleepMax": 4,

    "scrollMin": 2,
    "scrollMax": 5
  },

  "files": {
    "keywords": "data/keywords.json",
    "searchEngines": "data/search_engines.json"
  }
}
