{
  "browser": {
    "name": "chrome",
    "mode": "headless",
    "maximize": true,
    "browsers": ["chrome"]
  },

  "sessions": {
    "parallel": 4,
    "iterations": 1
  },

  "search": {
    "engines": ["google", "bing", "duckduckgo", "yahoo"],
    "maxPages": 20
  },

  "website": {
    "domain": "anubhavtrainings.com",
    "internal_links": {
      "enabled": true,
      "max_to_visit": 3,
      "selectors": ["//wix-dropdown-menu//a"]
    }
  },

  "youtube": {
    "targetChannel": "Anubhav Trainings",
    "watchTimeMin": 20,
    "watchTimeMax": 40,
    "maxScrolls": 10,

    "browserRestartAfterKeywords": 50,
    "browserRestartDelay": 10,

    "cycleDelay": 300,

    "healthCheckInterval": 180,

    "retryCount": 3
  },

  "timing": {
    "typingMin": 0.1,
    "typingMax": 0.25,

    "sleepMin": 2,
    "sleepMax": 4,

    "scrollMin": 2,
    "scrollMax": 5
  },

  "files": {
    "keywords": "data/keywords.json",
    "searchEngines": "data/search_engines.json"
  }
}
