{
  "browser": {
    "name": "chrome",
    "mode": "headed",
    "maximize": true
  },

  "sessions": {
    "parallel": 4,
    "iterations": 1
  },

  "search": {
    "engines": ["google", "bing", "duckduckgo", "yahoo"],
    "maxPages": 20
  },

  "website": {
    "domain": "anubhavtrainings.com"
  },

  "youtube": {
    "targetChannel": "Anubhav Trainings",
    "watchTimeMin": 20,
    "watchTimeMax": 40,
    "maxScrolls": 10
  },
  "timing": {
    "typingMin": 0.10,
    "typingMax": 0.25,

    "sleepMin": 2,
    "sleepMax": 4,

    "scrollMin": 2,
    "scrollMax": 5
  },

  "files": {
    "keywords": "data/keywords.json",
    "searchEngines": "data/search_engines.json"
  }
}
