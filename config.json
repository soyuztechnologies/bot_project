{
  "browser": {
    "name": "chrome",
    "mode": "headed",
    "maximize": true,

    "browsers": ["chrome"],

    "distribution": {
        "chrome" : 20,
        "edge" : 20,
        "opera" : 20,
        "firefox" : 20,
        "brave" : 20          
    }
  },

  "sessions": {
    "parallel": 5,
    "iterations": 1
  },

  "search": {
    "engines": ["yahoo", "duckduckgo", "google","bing" ],
    "maxPages": 20
  },

  "website": {
    "domain": "anubhavtrainings.com",
    "extra_keyword": "anubhav training",
    "internal_links": {
      "enabled": true,
      "max_to_visit": 3,
      "selectors": ["//wix-dropdown-menu//a"]
    }
  },

  "youtube": {
    "targetChannel": "Anubhav Trainings",
    "extra_keyword": "anubhav training",
    "watchTimeMin": 20,
    "watchTimeMax": 40,
    "maxScrolls": 1,
    "maxSearchPages": 1,

    "browserRestartAfterKeywords": 50,
    "browserRestartDelay": 10,

    "cycleDelay": 300,

    "healthCheckInterval": 180,

    "retryCount": 3
  },

  "timing": {
    "typingMin": 0.1,
    "typingMax": 0.25,

    "sleepMin": 2,
    "sleepMax": 4,

    "scrollMin": 2,
    "scrollMax": 5
  },

  "files": {
    "keywords": "data/keywords.json",
    "searchEngines": "data/search_engines.json"
  }
}
