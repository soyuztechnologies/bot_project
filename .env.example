# Copy to .env and fill in (setup.bat does this for you):
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/Mac)

# REQUIRED — MongoDB Atlas connection string (config.json uses current_db=atlas).
# Same value as on your working laptop.
MONGO_URI_ATLAS=mongodb+srv://<username>:<password>@<cluster-host>/seo_bot_db?retryWrites=true&w=majority

# Only needed if you switch config.json -> database.current_db=local
MONGO_URI_LOCAL=mongodb://localhost:27017/seo_bot_db

# Optional — database name override (defaults to seo_bot_db)
MONGO_DB_NAME=seo_bot_db

# Optional — Name of the user running the app or bot (appears in email reports, run logs, and dashboard).
# If left empty, falls back to "user_name" in config.json.
USER_NAME=

# Optional — Gmail app password for report e-mails (utils/mailer.py).
# Leave empty to skip e-mail reports.
GMAIL_APP_PASSWORD=

# IP bouncing (proxy rotation) — utils/proxy_manager.py.
# REQUIRED when config.json -> proxy.enabled=true and proxy.mode=single.
# Paste the rotating residential endpoint from your provider
# (Bright Data / Oxylabs / Webshare / Decodo ...). One URL is enough —
# the provider rotates the exit IP automatically, one per browser session.
# Examples:
#   PROXY_URL=http://brd-customer-hl_abc123-zone-residential:pass123@brd.superproxy.io:22225
#   PROXY_URL=http://user:pass@gate.decodo.com:10001
PROXY_URL=

# Optional — static proxy list (only for proxy.mode=list).
# Comma or newline separated. Overrides data/proxies.json when set.
# PROXY_LIST=http://u1:p1@host1:port,http://u2:p2@host2:port
